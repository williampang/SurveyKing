/* app.wxss - 全局样式 */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 32rpx;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 20rpx 0;
}

.btn-primary[disabled] {
  background: #b3d8ff;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
