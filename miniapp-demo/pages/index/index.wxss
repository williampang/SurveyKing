/* pages/index/index.wxss - 首页样式 */

page {
  background: #f2f3f5;
}

.home {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============ 欢迎 hero ============ */
.home-hero {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 20rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
  margin-bottom: 24rpx;
}
.home-logo { font-size: 88rpx; line-height: 1; margin-bottom: 20rpx; }
.home-title { font-size: 44rpx; font-weight: 700; margin-bottom: 16rpx; }
.home-slogan { font-size: 26rpx; opacity: 0.9; letter-spacing: 2rpx; }

/* ============ 通用卡片 ============ */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* ============ 广告词 ============ */
.ad-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}
.ad-item + .ad-item { border-top: 1rpx solid #f0f0f0; }
.ad-icon { font-size: 48rpx; line-height: 1; margin-right: 20rpx; }
.ad-text { flex: 1; }
.ad-head { font-size: 30rpx; font-weight: 600; color: #1d2129; margin-bottom: 8rpx; }
.ad-desc { font-size: 24rpx; color: #86909c; line-height: 1.5; }

/* ============ 行动卡片（扫码 / 演示） ============ */
.action-title { font-size: 32rpx; font-weight: 600; color: #1d2129; margin-bottom: 8rpx; }
.action-desc { font-size: 24rpx; color: #86909c; margin-bottom: 20rpx; line-height: 1.5; }

.scan-enter-btn {
  background: #1890ff;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 24rpx 0;
}
.scan-enter-btn:active { opacity: 0.85; }

/* ============ 演示列表 ============ */
.demo-list { margin-top: 8rpx; }
.demo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.demo-item:last-child { margin-bottom: 0; }
.demo-item:active { background: #e8f3ff; }
.demo-main { flex: 1; }
.demo-name { font-size: 30rpx; font-weight: 600; color: #1d2129; margin-bottom: 6rpx; }
.demo-id { font-size: 22rpx; color: #86909c; }
.demo-arrow { font-size: 40rpx; color: #c9cdd4; line-height: 1; }

/* ============ 我的测评：滑动删除 + 分页 ============ */
.my-item-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.my-item-wrap:last-child { margin-bottom: 0; }
/* 删除按钮垫在滑动条后面，左滑露出 */
.my-del {
  position: absolute;
  right: 0; top: 0; bottom: 0;
  width: 80px;               /* 与 js SWIPE_DEL_W 一致 */
  background: #f5222d;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.my-item {
  position: relative;
  z-index: 1;
  margin-bottom: 0;
  transition: transform 0.2s ease;
}
/* 分页 */
.my-pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.my-pager-btn { font-size: 26rpx; color: #1890ff; padding: 8rpx 16rpx; }
.my-pager-btn.disabled { color: #c9cdd4; }
.my-pager-info { font-size: 24rpx; color: #86909c; }

/* ============ 页脚 ============ */
.home-footer {
  text-align: center;
  font-size: 22rpx;
  color: #c9cdd4;
  padding: 16rpx 0 32rpx;
}
